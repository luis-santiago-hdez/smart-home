
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SensorReading {
  id          BigInt   @id @default(autoincrement())
  temperature Float
  humidity    Float
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("sensor_readings")
}
